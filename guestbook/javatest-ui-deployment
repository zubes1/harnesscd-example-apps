apiVersion: apps/v1
kind: Deployment
metadata:
  name: javatest-ui
spec:
  replicas: 3
  revisionHistoryLimit: 3
  selector:
    matchLabels:
      app: javatest-ui
  template:
    metadata:
      labels:
        app: javatest-ui
    spec:
      containers:
      - image: zubairaslam061/harnessjavatest:20
        name: javatest-ui
        ports:
        - containerPort: 80
